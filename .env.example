# Copy this file to .env for local overrides.
# Never commit real credentials or secrets.
EMY_APP_NAME=EMY Private AI OS
EMY_ENVIRONMENT=local
EMY_VERSION=0.1.0
EMY_HOST=127.0.0.1
EMY_PORT=8000
EMY_LOG_LEVEL=INFO
EMY_DATABASE_ECHO=false
EMY_IMPORT_MAX_FILE_SIZE_MB=25
EMY_VIDEO_GENERATION_CONFIG_FILE=video_generation.yaml
EMY_COMFYUI_BASE_URL=http://127.0.0.1:8188
